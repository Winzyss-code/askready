# Copy to .env.local. Never commit real keys.
# Required for checkpoint 1. Enable anonymous sign-ins in Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Required for saving practice and waitlist entries; not used by auth.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Required in later checkpoints for Whisper and TTS.
OPENAI_API_KEY=
# LLM provider is OpenAI. Optional separate key; falls back to OPENAI_API_KEY.
LLM_PROVIDER_API_KEY=
LLM_MODEL_FAST=gpt-4.1-mini
LLM_MODEL_STRONG=gpt-4.1

# Optional. Cloudflare Turnstile site key: new anonymous accounts and sign-in links must pass a CAPTCHA.
# Enable Turnstile with the matching secret in Supabase Auth → Bot and Abuse Protection first, or sign-up fails.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional. New sessions allowed from one network per UTC day, across all accounts (default 30).
NEW_SESSIONS_PER_IP_PER_DAY=
