# Copy to .env.local. Never commit real keys.
# Required for checkpoint 1. Enable anonymous sign-ins in Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Required for saving practice and waitlist entries; not used by auth.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Required in later checkpoints for Whisper and TTS.
OPENAI_API_KEY=
# LLM provider is OpenAI. Optional separate key; falls back to OPENAI_API_KEY.
LLM_PROVIDER_API_KEY=
LLM_MODEL_FAST=gpt-4.1-mini
LLM_MODEL_STRONG=gpt-4.1
